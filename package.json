{
  "name": "copy-with-line-numbers",
  "description": "Copy selected lines with line number (and file path).",
  "version": "0.0.4",
  "bugs": {
    "url": "https://github.com/kyto64/vscode-copy-with-line-numbers/issues"
  },
  "homepage": "https://github.com/kyto64/vscode-copy-with-line-numbers#readme",
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Copy With Line Numbers configuration",
      "properties": {
        "copyWithLineNumbers.showSuccessMessage": {
          "type": "boolean",
          "default": true,
          "description": "Show success message"
        }
      }
    },
    "commands": [
      {
        "command": "extension.copyWithLineNumbers.withoutPath",
        "title": "Copy With Line Numbers: Without Path"
      },
      {
        "command": "extension.copyWithLineNumbers.withFullPath",
        "title": "Copy With Line Numbers: With Full Path"
      },
      {
        "command": "extension.copyWithLineNumbers.withRelativePath",
        "title": "Copy With Line Numbers: With Relative Path"
      },
      {
        "command": "extension.copyWithLineNumbers.withFileName",
        "title": "Copy With Line Numbers: With File Name"
      }
    ]
  },
  "dependencies": {
    "left-pad": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.12.0",
    "glob": "^13.0.0",
    "mocha": "^12.0.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "displayName": "Copy With Line Numbers",
  "engines": {
    "vscode": "^1.74.0"
  },
  "icon": "images/icon.png",
  "keywords": [
    "copy",
    "line number"
  ],
  "license": "MIT",
  "main": "./out/src/extension",
  "publisher": "yassh",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyto64/vscode-copy-with-line-numbers.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run compile && node ./out/test/runTest.js",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  }
}
